{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "Bash(npm run render:*)",
      "Bash(npm run video:*)",
      "Bash(npm install)",
      "Bash(npx playwright install:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(open:*)",
      "Bash(sips:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(find:*)",
      "Bash(node:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push --force:*)"
    ]
  }
}
